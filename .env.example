# AI-owned SQLite
FACE_GROUPING_DB_PATH=./face_grouping.db

# Root containing configs/ and models/
FACE_GROUPING_ROOT=.

# Internal backend -> AI authentication. Set a strong secret in production.
FACE_GROUPING_INTERNAL_API_KEY=change-me

# HTTP upload guard
FACE_GROUPING_MAX_UPLOAD_MB=25

# Lifecycle policy
FACE_GROUPING_CONSOLIDATE_EVERY_PHOTOS=50
FACE_GROUPING_CONSOLIDATE_IDLE_HOURS=24

# Crash/retry ownership leases
FACE_GROUPING_PHOTO_LEASE_SECONDS=300
FACE_GROUPING_CONSOLIDATION_LEASE_SECONDS=1800

# face-grouping-api CLI defaults
FACE_GROUPING_API_HOST=127.0.0.1
FACE_GROUPING_API_PORT=8001
